{
    "name": "magebitcom/magento2-mcp-report-tools",
    "description": "Report-domain MCP tools for Magebit_Mcp (admin Reports menu + admin Dashboard + statistics refresh)",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "magento/framework": "^103.0",
        "magebitcom/magento2-mcp-module": "^1.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magebit\\McpReportTools\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
